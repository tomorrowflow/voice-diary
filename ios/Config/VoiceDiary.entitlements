<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.tomorrowflow.voice-diary</string>
    </array>
    <!-- Required so iOS jetsam doesn't kill us when the Gemma 4 E4B
         (4-bit) on-device LLM is resident alongside Parakeet STT and
         Piper TTS. Stock cap on iPhone 17 Pro is ~3-4 GB; this raises
         it to ~80 % of physical RAM. Capability must also be enabled
         in Signing & Capabilities for the App ID to permit it. -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
    <!-- Lets us mmap weight files larger than 4 GB and gives MLX a
         bigger virtual address space, which the Metal backend uses for
         large model buffers. Free entitlement, same capability flow. -->
    <key>com.apple.developer.kernel.extended-virtual-addressing</key>
    <true/>
</dict>
</plist>
