{
  "sourceLanguage" : "en",
  "strings" : {
    "\"System\" follows your iPhone language. Voice Diary ships with English and German — any other system language falls back to English. \"Deutsch\" forces German regardless of the system setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der iPhone-Sprache. Voice Diary liefert Englisch und Deutsch mit — jede andere System-Sprache landet auf Englisch. „Deutsch“ erzwingt Deutsch unabhängig von der System-Einstellung."
          }
        }
      }
    },
    "%@" : {
      "comment" : "A count of items in a storage category.",
      "isCommentAutoGenerated" : true
    },
    "%@ freed." : {
