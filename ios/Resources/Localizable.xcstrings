          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird geladen"
          }
        }
      }
    },
    "Downloading ~5 GB from Hugging Face. A few minutes on Wi-Fi, longer on cellular." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade ~5 GB von Hugging Face. Bei WLAN ein paar Minuten, bei Mobilfunk mehr."
          }
        }
      }
    },
    "Downloading ~5 GB. Keep this page open — if you switch apps or lock the phone, the download pauses and resumes when you come back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~5 GB werden heruntergeladen. Lass diese Seite geöffnet — wenn du die App wechselst oder das iPhone sperrst, pausiert der Download und läuft weiter, sobald du zurückkommst."
          }
        }
      }
    },
