    },
    "The server rejected the token (401). It doesn’t match the token configured on the server — paste it again and tap Save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den Token abgelehnt (401). Er stimmt nicht mit dem auf dem Server hinterlegten Token überein — füge ihn erneut ein und tippe auf Sichern."
          }
