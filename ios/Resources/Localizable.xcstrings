          }
        }
      }
    },
    "No internet connection. Connect to Wi-Fi and try again. Until then, the Apple model takes over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Internetverbindung. Verbinde dich mit WLAN und versuch es erneut. Bis dahin übernimmt das Apple-Modell."
          }
        }
      }
    },
    "No progress for over a minute. The download resumes automatically when the network returns, or tap “Retry” to restart — anything already downloaded is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit über einer Minute kein Fortschritt. Der Download läuft automatisch weiter, sobald das Netzwerk zurück ist — oder tippe auf „Erneut versuchen“. Bereits Heruntergeladenes bleibt erhalten."
          }
        }
      }
    },
    "No response" : {
