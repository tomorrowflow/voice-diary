          }
        }
      }
    },
    "%lld note(s) will be removed from the device. Server data is untouched. This can’t be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Notiz(en) werden vom Gerät entfernt. Server-Daten bleiben unberührt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
