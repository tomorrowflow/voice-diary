        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine eigenen Abschnitte. Tippe auf „Abschnitt hinzufügen“, um einen Opener mit Titel und Einleitung anzulegen."
          }
        }
      }
    },
    "No dictation asset installed yet — wake word can’t be enabled. Follow the steps below and tap “Re-check”." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
