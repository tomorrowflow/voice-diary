    },
    "After 6 seconds of silence, asks one short follow-up that matches the intro. If off, the section stays silent and waits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt nach 6 Sekunden Stille eine kurze, zur Einleitung passende Folgefrage. Ohne Aktivierung bleibt der Abschnitt still und wartet einfach."
          }
        }
      }
    },
    "All day" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganztägig"
          }
        }
      }
