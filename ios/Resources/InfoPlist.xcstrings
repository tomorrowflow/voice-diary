    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Diary nimmt deine Sprache auf, damit du den Tag chronologisch reflektieren kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Diary records your speech so you can reflect on the day chronologically."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Diary erkennt Befehle wie „weiter\" oder „fertig\" lokal auf dem Gerät, damit du den Walkthrough auch bei gesperrtem Bildschirm steuern kannst. Es wird nichts an Apple gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Diary recognises commands like \"next\" or \"done\" on-device so you can steer the walkthrough even with the screen locked. Nothing is sent to Apple."
          }
        }
      }
    }
  },
  "version" : "1.0"
