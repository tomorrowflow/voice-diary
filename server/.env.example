# Tailnet exposure (SEC-1). REQUIRED — must be this host's Tailscale IPv4
# address (100.64.0.0/10), never 0.0.0.0. docker-compose.yml publishes the
# webapp port as "${TAILNET_IP}:8000:8000"; the webapp container also reads
# it at startup and refuses to run if it's unset or outside that range.
# Find yours with `tailscale ip -4` on this host.
TAILNET_IP=

# Database
# POSTGRES_PASSWORD has no default — docker-compose.yml refuses to start
# without it. Generate a real secret per install, e.g.:
#   openssl rand -hex 32
# Use hex (not base64): the password is interpolated verbatim into
# DATABASE_URL, and base64's `/` and `+` are not URL-safe in userinfo.
# DATABASE_URL is assembled from these in docker-compose.yml; no need to set
# it separately here.
# Postgres only applies these when it first initialises the pgdata volume.
# On an existing volume, changing them here does not change the stored
# credentials: run ALTER USER inside the container, or recreate the volume.
POSTGRES_USER=diary
POSTGRES_PASSWORD=
POSTGRES_DB=diary_processor

# Whisper ASR sidecar (in-stack)
# Image tag picks CPU vs GPU build of onerahmet/openai-whisper-asr-webservice:
#   latest       — CPU
#   latest-gpu   — CUDA (also uncomment the deploy.resources block in docker-compose.yml)
WHISPER_IMAGE_TAG=latest
WHISPER_MODEL=medium
WHISPER_ENGINE=faster_whisper
WHISPER_URL=http://whisper:9000

# Ollama (LLM validation + analysis + narrative generation)
OLLAMA_BASE_URL=http://192.168.2.17:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=131072
LLM_VALIDATION_ENABLED=true

# document_processor's analysis call (summarize_context + analyze_transcript)
# talks to OLLAMA_BASE_URL over the OpenAI-compatible /v1/chat/completions
# shape, so it can point at any compatible base URL (e.g. Blindfold — see
# docs/adr/0001-blindfolded-cloud-egress-opt-in.md), not just Ollama.
# OLLAMA_ANALYSIS_MODEL defaults to OLLAMA_MODEL above.
# OLLAMA_ANALYSIS_TIMEOUT=300
#
# The OpenAI request shape has no field for Ollama-native `options.num_ctx`,
# so the large context window this call needs is no longer sent per-request.
# Configure it on the Ollama side instead, either:
#   - per-model, via a custom Modelfile:
#       FROM qwen2.5:14b
#       PARAMETER num_ctx 262144
#     then `ollama create qwen2.5-14b-262k -f Modelfile` and set
#     OLLAMA_ANALYSIS_MODEL=qwen2.5-14b-262k, or
#   - server-wide, via `OLLAMA_CONTEXT_LENGTH=262144` in the Ollama host's
#     own environment (restart the Ollama service after changing it).

# Timezone for calendar event display (default: Europe/Berlin)
TZ=Europe/Berlin

# Harvest time tracking (https://id.getharvest.com/developers)
HARVEST_ACCESS_TOKEN=your-personal-access-token-here
HARVEST_ACCOUNT_ID=your-account-id-here
HARVEST_USER_ID=user-id-for-sample-data

# Qdrant vector store (contextual learning)
QDRANT_URL=http://qdrant:6333
VECTOR_SEARCH_ENABLED=true

# LightRAG (external service)
LIGHTRAG_URL=http://192.168.2.16:9621
LIGHTRAG_API_KEY=

# ── LightRAG-side configuration (set these on the LightRAG host, NOT here) ──
# These vars are read by LightRAG itself, not by the Voice Diary server. They
# are listed here as a reminder of what the LightRAG deployment should be
# configured with so its extraction stays consistent with VD's analysis.
#
# RELATIONSHIP_TYPES: soft-priority list of edge labels LightRAG biases toward
# during relationship extraction (fork commit 59161b9). Mirrors the German
# vocabulary already enumerated in the analysis prompt in
# document_processor.py so the graph keeps a consistent edge schema across
# LightRAG-side extraction and VD-side Ollama analysis.
# Format: JSON list of strings, e.g.
# RELATIONSHIP_TYPES='["arbeitet_an","leitet","berichtet_an","reviewed","diskutierte_mit","delegierte_an","unterstützt","arbeitete_zusammen_mit","berät","implementiert","entwickelt","nutzt","integriert_mit","abhängig_von","ersetzt","gehört_zu","teil_von","verantwortlich_für","involviert_in","finanziert","partnert_mit","konkurriert_mit","plant","evaluiert","entschied_für","entschied_gegen"]'

# Microsoft Graph
# Create a public-client app registration in your Entra tenant with delegated
# scopes Calendars.Read + Mail.Read + offline_access. Allow public client
# flows = yes; redirect URI is not needed for device-code flow.
# Bootstrap once: docker compose run --rm webapp python scripts/msgraph_bootstrap.py
MSGRAPH_CLIENT_ID=
MSGRAPH_TENANT_ID=

# Set to true to serve canned calendar + email data from
# webapp/fixture_data/*.json (or <DATA_DIR>/fixtures/*.json) instead of
# hitting Microsoft Graph. Useful while waiting for Entra admin consent
# or for offline development. Flip to false (or remove) once the bootstrap
# has run and the cache file is in place.
MSGRAPH_FIXTURE_MODE=false

# iOS bearer token. Generate with:
#   docker compose run --rm webapp python scripts/issue_ios_token.py
# Paste the same value into the iOS app's onboarding screen.
IOS_BEARER_TOKEN=

# Voxtral TTS sidecar (in-stack, vLLM Omni serving Voxtral-4B-TTS-2603)
# - CC BY-NC 4.0 weights (personal-use only, see SPEC.md §4).
# - Requires nvidia-container-toolkit on the host; pinned to GPU 1.
# - Mistral models are gated on Hugging Face: accept the license at
#   huggingface.co/mistralai/Voxtral-4B-TTS-2603, generate a HF token,
#   paste it as HF_TOKEN below, then `docker compose up -d voxtral`.
# - `voxtral` is the lazy-wake gate; `voxtral-engine` is the real vLLM.
#   webapp talks only to the gate. See voxtral-gate/README.md.
HF_TOKEN=
VOXTRAL_BASE_URL=http://voxtral:8001
VOXTRAL_MODEL=mistralai/Voxtral-4B-TTS-2603
# Covers a wake (~1-2 s) plus synthesis on a request that lands cold.
VOXTRAL_TIMEOUT_SECONDS=60

# Lazy-wake gate. The engine holds ~19 GB of VRAM while awake, so it is
# put to sleep (weights → host RAM) after this many idle seconds and
# woken on the next synthesis request.
VOXTRAL_IDLE_SECONDS=300
# 1 = offload weights to host RAM (~1-2 s wake). 2 = discard them
# entirely: frees the host RAM too, but every wake re-reads the model.
VOXTRAL_SLEEP_LEVEL=1
# Sleep as soon as the engine finishes booting, rather than waiting out
# a first idle window with 19 GB resident.
VOXTRAL_SLEEP_ON_START=true
