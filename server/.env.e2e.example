# Environment of the isolated e2e stack (Compose project `vd-e2e`).
#
# `scripts/e2e_stack.py up` writes the real `.env.e2e` (gitignored) from this
# shape: it fills TAILNET_IP, POSTGRES_PASSWORD and IOS_BEARER_TOKEN itself and
# never reads the prod `.env`. Keep the two files' secrets different.

# This host's Tailscale IPv4 (tailscale ip -4). The webapp is published on
# ${TAILNET_IP}:8100. Placeholder only; never commit the real value.
TAILNET_IP=100.x.y.z

POSTGRES_USER=diary
POSTGRES_PASSWORD=<generated: openssl rand -hex 32>
POSTGRES_DB=diary_processor

# The e2e bearer. Its own value, not the prod IOS_BEARER_TOKEN.
IOS_BEARER_TOKEN=<generated: openssl rand -hex 32>

# Microsoft Graph from bundled fixtures; Harvest off.
MSGRAPH_FIXTURE_MODE=true

# Fixture Ollama + LightRAG on the stack network (service `upstreams`).
OLLAMA_BASE_URL=http://upstreams:11434
LIGHTRAG_URL=http://upstreams:9621
LLM_VALIDATION_ENABLED=false
FLUENCY_CHECK_ENABLED=false

VECTOR_SEARCH_ENABLED=true
QDRANT_URL=http://qdrant:6333
WHISPER_URL=http://whisper:9000
TZ=Europe/Berlin

# Whisper on CPU. Any faster-whisper model name; `small` is the default.
# E2E_WHISPER_MODEL=small
