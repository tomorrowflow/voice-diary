# Throwaway values for the verify-server stack (project `vd-verify`). Not secrets:
# the stack publishes no host port, lives on its own Compose network, and is
# destroyed (`down -v`) after each run. Never put a real token, password, or
# anything from server/.env in here.
#
# TAILNET_IP is a dummy CGNAT address that only satisfies bind_guard; the override
# removes the host port publish, so nothing is bound to it.
TAILNET_IP=100.64.0.1
POSTGRES_USER=diary
POSTGRES_PASSWORD=verify-only-not-a-secret
POSTGRES_DB=diary_processor
IOS_BEARER_TOKEN=verify-only-bearer-not-a-secret
# Server's own fixture mode: calendar routes serve bundled JSON, no Entra needed.
MSGRAPH_FIXTURE_MODE=true
# Empty => the /health probes report "skipped" instead of calling LAN hosts.
OLLAMA_BASE_URL=
LIGHTRAG_URL=
LLM_VALIDATION_ENABLED=false
VECTOR_SEARCH_ENABLED=true
QDRANT_URL=http://qdrant:6333
TZ=Europe/Berlin
