FROM node:22-bookworm

# --- base tooling (root) ---
# ffmpeg is required by the server audio pipeline (SPEC end-to-end flow).
RUN apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  ffmpeg \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI (issue read/comment from inside the sandbox)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# The agent user is UID/GID 1000 inside the image. Rootless Podman runs the
# container with --userns=keep-id:uid=1000,gid=1000 (sandcastle's podman()
# default), which maps the host user onto this UID, so image-built files and
# bind-mounted files share an owner without a runtime chown. Keep these at 1000
# unless you also pass containerUid/containerGid to podman() in main.mts.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Rename the base image's "node" user to "agent" and align UID/GID.
RUN groupmod -o -g $AGENT_GID node && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node
USER ${AGENT_UID}:${AGENT_GID}

# Install Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash

# uv — manages Python 3.12 and builds the server venv. Debian bookworm only ships
# Python 3.11; the server targets 3.12 (CLAUDE.md), so uv fetches a standalone 3.12.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Claude, uv, and the baked server venv all on PATH.
ENV PATH="/home/agent/.local/bin:/home/agent/venv/bin:$PATH"

# --- server track: Python 3.12 venv with pinned deps + pytest, baked into the image ---
# The sandbox mounts the worktree read-write; server unit tests (mocked MSAL/LightRAG/
# Ollama/Whisper) run against this venv with no per-run install. Integration tests that
# need a live `docker compose up` are deliberately OUT OF SCOPE here — they stay a
# host-side gate (see docs/SANDCASTLE-SETUP-PLAN.md §4). requirements.txt already pins
# pytest + pytest-asyncio.
COPY --chown=${AGENT_UID}:${AGENT_GID} server/webapp/requirements.txt /tmp/requirements.txt
RUN uv venv /home/agent/venv --python 3.12 \
  && uv pip install --python /home/agent/venv -r /tmp/requirements.txt

# --- iOS track: EDIT-ONLY in the sandbox ---
# xcodebuild does not run on Linux. iOS branches are written here and verified on the
# macOS host (scripts/verify_agent_branch.sh). No Swift toolchain is installed.

WORKDIR /home/agent

# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at /home/agent/workspace
# and overrides the working directory to /home/agent/workspace at container start.
ENTRYPOINT ["sleep", "infinity"]
