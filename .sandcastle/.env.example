# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=

# ── Agent models ──────────────────────────────────────────────────────────────
# Per-role model: # SANDCASTLE_MODEL_<ROLE>=<provider>:<model>, or a bare <model> for
# the default provider. Roles: PLAN, IMPLEMENT, REVIEW, MERGE. A role left unset
# (or commented out) runs on claude-sonnet-5, the built-in default in main.mts.
# The reviewer is the fail-closed merge gate: keep it on the strongest model.
# SANDCASTLE_MODEL_PLAN=anthropic:claude-opus-5-5
# SANDCASTLE_MODEL_IMPLEMENT=ollama:glm-5.3
# SANDCASTLE_MODEL_REVIEW=anthropic:claude-opus-5-5
# SANDCASTLE_MODEL_MERGE=anthropic:claude-sonnet-5

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Setting OLLAMA_MODEL makes Ollama the default provider for every role you don't
# override above. Comment it out to switch back to Anthropic. The Anthropic token
# can stay: roles on Ollama don't use it.
# Cloud model names: curl -s https://ollama.com/api/tags  (e.g. kimi-k2.7-code, glm-5.3)
# OLLAMA_MODEL=kimi-k2.7-code
# OLLAMA_API_KEY=            # https://ollama.com/settings/keys (needed for Ollama Cloud)
# Local Ollama on this Mac instead of the cloud (no key; model needs >=64k context,
# e.g. OLLAMA_CONTEXT_LENGTH=65536 on the Ollama server):
# OLLAMA_BASE_URL=http://host.containers.internal:11434
